# "mock" uses deterministic, clearly-labelled fixtures. "http" talks to the backend.
NEXT_PUBLIC_API_MODE=mock
# Backend base URL INCLUDING the /api/v1 prefix (used when NEXT_PUBLIC_API_MODE=http).
# The backend's default CORS origins are http://localhost:3000 and http://127.0.0.1:3000 (override with MSI_CORS_ORIGINS).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
